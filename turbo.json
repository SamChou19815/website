{
  "globalDependencies": ["configuration/*"],
  "tasks": {
    "check": {
      "dependsOn": ["^check"],
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "deploy": {
      "dependsOn": ["build"]
    }
  }
}
